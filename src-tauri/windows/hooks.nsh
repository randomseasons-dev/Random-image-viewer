; Picture types: "Open with" entries + a Windows "Default apps" page for Picture Viewer.
; (The type itself -> PictureViewer.Image is registered by Tauri's fileAssociations.)

!macro NSIS_HOOK_POSTINSTALL
  WriteRegStr SHCTX "Software\Classes\.jpg\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".jpg" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.jpeg\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".jpeg" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.jpe\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".jpe" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.jfif\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".jfif" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.pjpeg\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".pjpeg" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.pjp\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".pjp" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.png\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".png" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.apng\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".apng" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.gif\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".gif" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.webp\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".webp" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.bmp\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".bmp" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.dib\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".dib" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.ico\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".ico" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.svg\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".svg" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.avif\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".avif" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.tif\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".tif" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.tiff\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".tiff" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.tga\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".tga" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.dds\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".dds" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.hdr\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".hdr" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.exr\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".exr" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.qoi\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".qoi" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.pnm\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".pnm" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.pbm\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".pbm" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.pgm\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".pgm" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.ppm\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".ppm" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.pam\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".pam" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\Classes\.ff\OpenWithProgids" "PictureViewer.Image" ""
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities\FileAssociations" ".ff" "PictureViewer.Image"
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities" "ApplicationName" "Picture Viewer"
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities" "ApplicationDescription" "Picture and video viewer"
  WriteRegStr SHCTX "Software\RandomSeasons\PictureViewer\Capabilities" "ApplicationIcon" "$INSTDIR\${MAINBINARYNAME}.exe,0"
  WriteRegStr SHCTX "Software\RegisteredApplications" "Picture Viewer" "Software\RandomSeasons\PictureViewer\Capabilities"
  WriteRegStr SHCTX "Software\Classes\Applications\${MAINBINARYNAME}.exe\shell\open\command" "" "$\"$INSTDIR\${MAINBINARYNAME}.exe$\" $\"%1$\""
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
!macroend

!macro NSIS_HOOK_POSTUNINSTALL
  DeleteRegValue SHCTX "Software\Classes\.jpg\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.jpeg\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.jpe\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.jfif\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.pjpeg\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.pjp\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.png\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.apng\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.gif\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.webp\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.bmp\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.dib\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.ico\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.svg\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.avif\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.tif\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.tiff\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.tga\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.dds\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.hdr\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.exr\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.qoi\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.pnm\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.pbm\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.pgm\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.ppm\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.pam\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\Classes\.ff\OpenWithProgids" "PictureViewer.Image"
  DeleteRegValue SHCTX "Software\RegisteredApplications" "Picture Viewer"
  DeleteRegKey SHCTX "Software\RandomSeasons\PictureViewer"
  DeleteRegKey /ifempty SHCTX "Software\RandomSeasons"
  DeleteRegKey SHCTX "Software\Classes\Applications\${MAINBINARYNAME}.exe"
  System::Call 'shell32::SHChangeNotify(i 0x08000000, i 0, p 0, p 0)'
!macroend
