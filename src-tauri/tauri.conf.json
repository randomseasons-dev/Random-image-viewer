{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Picture Viewer",
  "mainBinaryName": "Picture Viewer",
  "version": "1.2.0",
  "identifier": "com.randomseasons.pictureviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Picture Viewer",
        "width": 1400,
        "height": 860,
        "minWidth": 800,
        "minHeight": 500,
        "maximized": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "jpg",
          "jpeg",
          "jpe",
          "jfif",
          "pjpeg",
          "pjp",
          "png",
          "apng",
          "gif",
          "webp",
          "bmp",
          "dib",
          "ico",
          "svg",
          "avif",
          "tif",
          "tiff",
          "tga",
          "dds",
          "hdr",
          "exr",
          "qoi",
          "pnm",
          "pbm",
          "pgm",
          "ppm",
          "pam",
          "ff"
        ],
        "name": "PictureViewer.Image",
        "description": "Picture",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}